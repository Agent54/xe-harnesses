# External HTTPS origin served by the reverse proxy; keep its Host header intact.
# For direct access without the proxy, use http://localhost:8780 instead.
PUBLIC_URL=https://openwork_harness-openwork.app.localhost
# Generate each token separately with: openssl rand -hex 32
OPENWORK_TOKEN=
OPENWORK_HOST_TOKEN=
# Optional: provider credentials can also be configured in OpenWork.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
