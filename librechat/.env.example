# External HTTPS origin; register OAuth redirect URIs under this origin.
PUBLIC_URL=https://librechat_harness-librechat.app.localhost
# Number of trusted reverse-proxy hops. The local TLS router is one hop.
TRUST_PROXY=1
# Generate each value separately. Never add this file's filled-in copy to git.
# JWT values: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# 32-byte key (64 hex characters): openssl rand -hex 32
CREDS_KEY=
# 16-byte IV (32 hex characters): openssl rand -hex 16
CREDS_IV=
# Optional: leave unset to enter your provider key through LibreChat.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
