# External HTTPS origin; the relay advertises its matching wss:// URL.
PUBLIC_URL=https://relay_harness-buzz.app.localhost
# Optional extra browser/native origins, comma-separated; defaults to PUBLIC_URL.
# BUZZ_CORS_ORIGINS=https://relay_harness-buzz.app.localhost,tauri://localhost
# Generate each key/secret with: openssl rand -hex 32
BUZZ_RELAY_PRIVATE_KEY=
BUZZ_GIT_HOOK_HMAC_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BUZZ_S3_ACCESS_KEY=buzz-local
BUZZ_S3_SECRET_KEY=
# Optional agent profile; generate its identity with buzz-admin (see README).
BUZZ_PRIVATE_KEY=
GOOSE_PROVIDER=openai
GOOSE_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
