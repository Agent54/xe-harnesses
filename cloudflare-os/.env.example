# Public browser origin. Changing this runtime value needs a container restart.
PUBLIC_URL=https://cloudflare-os_harness-cloudflare-os.app.localhost
# Optional runtime settings; copy this file to .env only when needed.
# Configure model providers in the web UI. Cloudflare AI Gateway is optional.
# CF_AI_GATEWAY=your-gateway-name
# CF_AI_GATEWAY_ACCOUNT_ID=your-account-id
# CF_AI_GATEWAY_API_TOKEN=your-token
# CF_AI_GATEWAY_USE_BINDING=false
# GITHUB_CLIENT_ID=your-oauth-client-id
# GITHUB_CLIENT_SECRET=your-oauth-client-secret
